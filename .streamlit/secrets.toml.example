# DATOS FICTICIOS. Copia a secrets.toml y sustituye todos los valores.
# Nunca subas el archivo real a GitHub.
[google_sheet]
sheet_id = "ID_DE_EJEMPLO"

[admin]
password = "CAMBIA_ESTA_CONTRASENA_DE_EJEMPLO"

[gcp_service_account]
type = "service_account"
project_id = "proyecto-de-ejemplo"
private_key_id = "ID_FICTICIO"
private_key = """-----BEGIN PRIVATE KEY-----
CLAVE_FICTICIA_REEMPLAZAR
-----END PRIVATE KEY-----
"""
client_email = "torneos@proyecto-de-ejemplo.iam.gserviceaccount.com"
client_id = "000000000000000000000"
token_uri = "https://oauth2.googleapis.com/token"
